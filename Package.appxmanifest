<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" IgnorableNamespaces="uap rescap">
  <!-- Keep these identity values aligned with Partner Center before building the Store package. -->
  <Identity Name="Zorbey.Everstep" Publisher="CN=7E9C97B3-EC5B-4A25-A7BF-3C59BAA59DF3" Version="1.3.1.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Everstep</DisplayName>
    <PublisherDisplayName>Zorbey</PublisherDisplayName>
    <Logo>app\resources\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="tr-tr" />
    <Resource Language="en-us" />
    <Resource Language="es-es" />
    <Resource Language="ja-jp" />
    <Resource Language="de-de" />
    <Resource Language="it-it" />
    <Resource Language="az-latn-az" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application Id="Everstep" Executable="app\Everstep.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements AppListEntry="default" DisplayName="Everstep" Description="Pomodoro timer, task management and focus analytics" BackgroundColor="#0B1020" Square44x44Logo="app\resources\Square44x44Logo.png" Square150x150Logo="app\resources\Square150x150Logo.png">
        <uap:DefaultTile Wide310x150Logo="app\resources\Wide310x150Logo.png" Square310x310Logo="app\resources\Square310x310Logo.png" ShortName="Everstep" />
        <uap:SplashScreen Image="app\resources\SplashScreen.png" BackgroundColor="#0B1020" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
