{
  "name": "everstep",
  "productName": "Everstep",
  "version": "1.3.1",
  "description": "Secure, privacy-first offline Pomodoro timer, task planner, focus analytics and ambient sound desktop application for Windows.",
  "author": "Batuhan Zorbey Mermer",
  "license": "MIT",
  "homepage": "https://github.com/batuhanzorbeyy/everstep#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batuhanzorbeyy/everstep.git"
  },
  "bugs": {
    "url": "https://github.com/batuhanzorbeyy/everstep/issues"
  },
  "keywords": [
    "pomodoro",
    "focus-timer",
    "productivity",
    "electron",
    "windows",
    "offline-first"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run security:check && tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-forge package --platform=win32 --arch=x64",
    "make:msix": "npm run audio:check && npm run build && npm run sync:manifest && npm run clean:msix && electron-forge make --platform=win32 --arch=x64 --targets @electron-forge/maker-msix",
    "make:zip": "npm run audio:check && npm run build && electron-forge make --platform=win32 --arch=x64 --targets @electron-forge/maker-zip",
    "test": "vitest run",
    "sync:manifest": "node scripts/sync-manifest-version.cjs",
    "clean:msix": "node scripts/clean-msix-output.cjs",
    "audio:check": "node scripts/check-release-audio.cjs",
    "store:build": "powershell -ExecutionPolicy Bypass -File .\\BUILD_MSIX.ps1",
    "security:check": "node scripts/security-check.cjs",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-msix": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^43.4.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  }
}
